# --- Base de datos PostgreSQL (Docker / Local / Producción) ---
POSTGRES_USER=bexai
POSTGRES_PASSWORD=bexai123
DB_HOST=localhost
DB_PORT=5432

# URLs JDBC por servicio (opcional si usas DB_HOST/DB_PORT, útil en cloud)
# AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
# CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog_db
# INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory_db

# --- Service Discovery (Eureka) ---
EUREKA_URI=http://localhost:8761/eureka

# --- Seguridad JWT (IMPORTANTE: usar una clave segura de >= 32 bytes en producción) ---
